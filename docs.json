{
  "$schema": "https://mintlify.com/docs.json",
  "name": "TimeNest",
  "theme": "almond",
  "favicon": "https://media.brand.dev/ab4421ad-02c1-4b50-8342-e4d0cedd1b00.svg",
  "colors": {
    "primary": "#4f46e5",
    "light": "#d9f15f",
    "dark": "#4f46e5"
  },
  "appearance": {
    "default": "dark"
  },
  "font": {
    "headings": { "family": "Inter" },
    "body": { "family": "Inter" },
    "mono": { "family": "JetBrains Mono" }
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Empieza gratis",
      "href": "https://timenest.app/registro"
    }
  },
  "navigation": {
    "groups": [
      {
        "group": "Primeros Pasos",
        "pages": [
          "introduccion",
          "crear-cuenta",
          "configurar-negocio",
          "publicar-pagina-de-reservas"
        ]
      },
      {
        "group": "Configuración",
        "pages": [
          "configuracion/servicios",
          "configuracion/horarios",
          "configuracion/bloqueos-y-dias-festivos",
          "configuracion/personal"
        ]
      },
      {
        "group": "Citas",
        "pages": [
          "citas/crear-y-cancelar",
          "citas/politica-de-cancelacion",
          "citas/vista-de-agenda",
          "citas/estados"
        ]
      },
      {
        "group": "Clientes",
        "pages": [
          "clientes/registro",
          "clientes/historial-y-notas"
        ]
      },
      {
        "group": "Notificaciones por WhatsApp",
        "pages": [
          "whatsapp/mensajes-al-cliente",
          "whatsapp/recordatorios-y-confirmaciones",
          "whatsapp/personalizacion"
        ]
      },
      {
        "group": "Suscripción y Facturación",
        "pages": [
          "suscripcion/planes",
          "suscripcion/cambiar-plan",
          "suscripcion/metodos-de-pago"
        ]
      },
      {
        "group": "Cuenta",
        "pages": [
          "cuenta/usuarios-y-roles",
          "cuenta/seguridad"
        ]
      },
      {
        "group": "Ayuda",
        "pages": [
          "preguntas-frecuentes",
          "solucion-de-problemas"
        ]
      }
    ]
  },
  "footer": {
    "socials": {
      "website": "https://timenest.app"
    }
  },
  "logo": {
    "light": "/logo/timenest-light-full.png",
    "dark": "/logo/timenest-dark-full.png"
  }
